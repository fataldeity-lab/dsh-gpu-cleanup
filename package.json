{
  "name": "@princepainter/dsh-gpu-cleanup",
  "description": "DeepSeek Harness (DSH) Web UI plugin: one click inside the plugin (settings card or the conversation-header button) unloads every llama-swap model and sweeps stale local engines, freeing VRAM while llama-swap itself keeps running.",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.js",
      "default": "./lib/client.js"
    },
    "./invariant": {
      "types": "./lib/invariant.js",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/client.js",
    "lib/index.js",
    "lib/invariant.js",
    "cordis.patch.yml"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ollama",
    "gpu",
    "vram",
    "comfyui",
    "cuda"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-locale": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.0-rc.2"
  }
}
